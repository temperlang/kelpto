<Project Sdk="Microsoft.NET.Sdk">
  <!-- Times kelpto-md against Markdig; see ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <!-- Exact versions, transitive ones too, in packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="[1.5.1]" />
    <!-- Built by `temper build -b csharp` at the repo's top. -->
    <ProjectReference Include="../../temper.out/csharp/kelpto-md/src/KelptoMd.csproj" />
  </ItemGroup>
</Project>
